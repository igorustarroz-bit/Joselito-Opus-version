  "usage": {
    "intro": "_Propuesta pendiente de OK de diseño._ Úsalo para pedir un código de verificación enviado por SMS o correo.",
    "do": [
      "Ajusta el número de casillas (de 3 a 6) a la longitud real del código.",
      "Usa el mensaje para indicar dónde se envió el código o explicar el error.",
      "Reacciona a `onComplete` para validar en cuanto se rellenan todas las casillas."
    ],
    "dont": [
      "No lo uses para textos o contraseñas: es solo para códigos cortos.",
      "No dejes el estado Error sin mensaje que explique qué ha fallado."
    ]
  },
