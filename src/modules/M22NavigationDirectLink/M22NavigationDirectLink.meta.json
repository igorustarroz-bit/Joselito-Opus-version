  "usage": {
    "intro": "_Propuesta pendiente de OK de diseño._ Úsalo como fila de un listado (colecciones, artistas…) que enlaza a una página o despliega un texto con imagen.",
    "do": [
      "Etiqueta corta arriba y nombre corto como título.",
      "Agrupa varias filas seguidas para formar la lista.",
      "Usa SOLD OUT solo en Direct Link y cuando el elemento está agotado."
    ],
    "dont": [
      "No mezcles Direct Link y Deploy en la misma lista.",
      "No metas textos largos en el título.",
      "No pongas botones dentro de la fila: toda ella es clicable."
    ]
  },
